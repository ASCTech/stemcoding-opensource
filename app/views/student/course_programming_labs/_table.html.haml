%table.table.table-bordered
  %thead
    %tr
      %th Course
      %th Programming Lab
      %th Latest Submission
  %tbody
    - row_index = 0
    - course_labs.each do |course_lab|
      %tr
        - if row_index == 0
          - row_index += 1
          %td{rowspan: course_lab.course.programming_labs.count}
            = link_to course_lab.course_title, [:student, course_lab.course]
        - elsif row_index == course_lab.course.programming_labs.count-1
          - row_index = 0
        - else
          - row_index += 1
        %td= link_to course_lab.lab_title, [:student, course_lab]
        %td
          .btn-group
            - if submission = course_lab.submissions.authored_by(current_user.enrollments).reorder_by_created_at(:desc).first
              = link_to "View current submission", [:student, course_lab, submission], class: "btn btn-success"
            - if policy([:student, course_lab.submissions.authored_by(current_user.enrollments).new]).create?
              = link_to "Start submission", [:new, :student, course_lab, :submission], class: "btn btn-warning"

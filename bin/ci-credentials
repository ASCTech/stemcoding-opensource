#!/usr/bin/env bash
#
# Generate an ephemeral Rails credentials vault for CI.
#
# The production master.key is never committed, but the app requires a
# decryptable credentials vault to boot (database.yml, cable.yml, sidekiq.rb,
# and routes.rb all read Rails.application.credentials). This creates a
# throwaway vault with the minimal keys the test environment needs, so CI is
# self-contained and works on forks without any repository secrets.
#
set -euo pipefail

MASTER_KEY="${RAILS_MASTER_KEY:-$(openssl rand -hex 16)}"
printf '%s' "$MASTER_KEY" > config/master.key
export RAILS_MASTER_KEY="$MASTER_KEY"

SECRET_KEY_BASE="$(openssl rand -hex 64)"

rm -f config/credentials.yml.enc

CREDS_FILE="$(mktemp)"
# config/database.yml is ERB-rendered in full at load time, so credentials must
# define every environment it references (development/test/staging/production),
# even though CI only runs in test. Values for non-test envs are dummy
# placeholders — they are never connected to.
cat > "$CREDS_FILE" <<YAML
secret_key_base: ${SECRET_KEY_BASE}
database:
  development:
    name: stemcoding_development
    host: postgres
    username: postgres
    password:
  test:
    name: stemcoding_test
    host: postgres
    username: postgres
    password:
  staging:
    name: stemcoding_staging
    host: localhost
    username: postgres
    password:
  production:
    name: stemcoding_production
    host: localhost
    username: postgres
    password:
redis:
  development:
    url: redis://redis:6379/0
    password:
  test:
    url: redis://redis:6379/0
    password:
  staging:
    url: redis://redis:6379/0
    password:
  production:
    url: redis://redis:6379/0
    password:
subdomain:
  app:
    development: development
    test: test
    staging: staging
    production: app
  player:
    development: player
    test: player
    staging: player
    production: player
YAML

# `credentials:edit` opens the decrypted file with $EDITOR then re-encrypts it.
# Using `cp <our file>` as the editor overwrites it with our content.
EDITOR="cp ${CREDS_FILE}" bundle exec rails credentials:edit
rm -f "$CREDS_FILE"

echo "Ephemeral CI credentials written to config/credentials.yml.enc"

# Copy to .env and adjust. These are read at runtime via ENV.fetch(...).
# Secrets that must stay secret (DB passwords, secret_key_base, Redis auth) live
# in the Rails encrypted credentials vault, NOT here. See credentials.sample.

# --- Web / mail ---------------------------------------------------------------
# Public host the app is served from (used for mailer URLs and CSP frame hosts).
APP_HOST=localhost

# Outbound SMTP relay for ActionMailer in production/staging.
SMTP_ADDRESS=localhost
SMTP_PORT=25

# "From" address on all outgoing mail.
MAILER_SENDER=no-reply@example.com

# In development, all mail is redirected here instead of real recipients.
DEV_INTERCEPT_EMAIL=dev@example.com

# In staging, if set, all mail is redirected to this single inbox.
# Leave unset to send mail normally.
# STAGING_INTERCEPT_EMAIL=staging@example.com

# --- Seeds --------------------------------------------------------------------
# Password given to the seeded development admin account (development only).
SEED_ADMIN_PASSWORD=password

# --- Rails runtime (typically set by the platform / Docker) -------------------
# RAILS_ENV=development
# Decrypts config/credentials.yml.enc in environments where you don't ship the
# master.key file. Generate your own — never commit it.
# RAILS_MASTER_KEY=
# RAILS_LOG_TO_STDOUT=true
# RAILS_SERVE_STATIC_FILES=true

# --- Containerized DB/cache (set by docker-compose; override for other setups)-
# CONTAINERIZED=true
# DATABASE_HOST=postgres
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
# REDIS_URL=redis://redis:6379/
